# ==============================================================================
# KubeMind Enterprise Environment Configuration Blueprint (.env.example)
#
# Copy this file to .env and configure values for your deployment.
# All microservices resolve their endpoints and settings dynamically from these
# environment variables and corresponding YAML configurations.
# ==============================================================================

# ── 1. Core Platform & Deployment Mode ────────────────────────────────────────
# Deployment Profile: "local" (laptop Compose) or "production" (refuses open auth / direct keys)
KUBEMIND_DEPLOYMENT=local

# Credential Ownership: "direct" (explicit dev keys) or "keymint" (zero-trust KMS)
KUBEMIND_CREDENTIAL_MODE=direct

# Tenancy & API Key Bindings: "key1:ws1:role,key2:ws2:role" (e.g. "km-dev-key:default:admin")
KUBEMIND_API_KEYS=kmind-local-dev-key:default:admin
KUBEMIND_ADMIN_KEY=
KUBEMIND_SERVICE_KEY=
KUBEMIND_WORKSPACE=default

# CORS Allowed Origins (comma-separated, wildcards prohibited)
KUBEMIND_CORS_ORIGINS=http://localhost:9000,http://localhost:3000

# ── 2. Service Discovery Endpoints ───────────────────────────────────────────
ROUTER_URL=http://localhost:9080
MIND_URL=http://localhost:9081
AGENTS_URL=http://localhost:9082
SENTINEL_URL=http://localhost:9083
DASHBOARD_URL=http://localhost:9000

# ── 3. Database & Caching ────────────────────────────────────────────────────
# PostgreSQL with pgvector (used by Mind, Sentinel, and Router Usage Tracker)
POSTGRES_USER=tricore
POSTGRES_PASSWORD=tricore
POSTGRES_DB=tricore
DATABASE_URL=postgresql://tricore:tricore@localhost:5432/tricore

# Redis Cache (Exact & Semantic cache backend)
REDIS_URL=redis://localhost:6379/0
KUBEMIND_SEMANTIC_CACHE_BACKEND=redis

# ── 4. Local Inference (Ollama / vLLM / DeepSeek) ─────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
AGENT_MODEL=llama3.1

# Optional OpenAI-compatible local servers:
# VLLM_BASE_URL=http://localhost:8000/v1
# DEEPSEEK_LOCAL_BASE_URL=http://localhost:11434

# ── 5. Cloud LLM Providers (Direct mode only; unused in KeyMint mode) ─────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
KIMI_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=

# ── 6. External Microservice Integrations ────────────────────────────────────
# OpenDesk / PiSigma Identity (RS256 JWT & JWKS)
AUTH_SERVICE_URL=http://localhost:8090
AUTH_JWKS_URL=http://localhost:8090/.well-known/jwks.json

# PayDeck Razorpay Metered Billing Engine
PAYDECK_URL=http://localhost:8787
PAYDECK_API_KEY=

# ── 7. Operator Dashboard & NextAuth ─────────────────────────────────────────
NEXTAUTH_URL=http://localhost:9000
NEXTAUTH_SECRET=change-me-to-a-secure-random-32-byte-secret
NEXT_PUBLIC_API_BASE=http://localhost:9080
NEXT_PUBLIC_PAYDECK_URL=http://localhost:8787
NEXT_PUBLIC_SENTINEL_WS=ws://localhost:9083/v1/stream

# ── 8. Observability & S3 Cloud Sync (Optional) ──────────────────────────────
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
