# ── Tricore Environment ──────────────────────────────────────────

# Workspace
TRICORE_WORKSPACE_ID=default
TRICORE_API_KEY=tricore-local-dev-key

# Database (Docker Compose handles this, override for external)
POSTGRES_USER=tricore
POSTGRES_PASSWORD=tricore
POSTGRES_DB=tricore
DATABASE_URL=postgresql://tricore:tricore@postgres:5432/tricore

# Cache
REDIS_URL=redis://redis:6379/0

# ── LLM Providers (at least Ollama required) ─────────────────────
# local = laptop Compose (open/direct allowed). production = refuse open auth
# and refuse direct credential mode.
KUBEMIND_DEPLOYMENT=local
# Local compatibility mode. Production should use `keymint`; requests cannot
# override this value and KeyMint mode never falls back to these direct keys.
KUBEMIND_CREDENTIAL_MODE=direct
OLLAMA_BASE_URL=http://ollama:11434

# Direct-mode provider keys only. Keep empty in KeyMint mode.
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Auth (Dashboard) ─────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-to-random-32-byte-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Observability Cloud Sync (optional) ──────────────────────────
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
