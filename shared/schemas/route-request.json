{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubemind.ai/schemas/route-request.json",
  "title": "RouteRequest",
  "description": "POST /v1/route body (router) — planned Phase 1",
  "x-kubemind-status": "implemented",
  "x-kubemind-service": "router",
  "x-kubemind-phase": 1,
  "type": "object",
