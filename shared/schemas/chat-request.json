{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubemind.ai/schemas/chat-request.json",
  "title": "ChatRequest",
  "description": "POST /v1/chat/completions body (router)",
  "x-kubemind-status": "implemented",
  "x-kubemind-service": "router",
  "type": "object",
  "required": ["model", "messages"],
  "properties": {
    "model": { "type": "string" },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant", "tool"]
          },
          "content": { "type": "string" },
          "name": { "type": ["string", "null"] }
        }
      }
    },
    "temperature": { "type": ["number", "null"], "minimum": 0, "maximum": 2 },
    "max_tokens": { "type": ["integer", "null"], "minimum": 1 },
    "top_p": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "stream": { "type": ["boolean", "null"] },
    "tools": { "type": ["array", "null"] },
    "tool_choice": {}
  },
  "additionalProperties": true
}
