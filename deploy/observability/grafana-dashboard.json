      "id": 2,
      "title": "Request Throughput by Intent (QPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(kubemind_requests_total[1m])) by (intent)",
          "legendFormat": "{{ intent }}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
