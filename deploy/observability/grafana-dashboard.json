            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Latency (s)",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "title": "P95 Latency by Provider",
      "type": "timeseries",
